generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLAYER
  SUPPORT
  MODERATOR
  ADMIN
  ROOT_OWNER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum CharacterArchetype {
  VANGUARD
  RANGER
  ARCANIST
}

enum CharacterOrigin {
  FORMER_SENTINEL
  ROAD_SURVIVOR
  ARCHIVE_EXILE
}

enum AvatarMode {
  STATIC
  DYNAMIC
}

enum WorldLocation {
  BROKEN_WATCHPOST
  HOLLOW_ROAD
  CINDERHAVEN_GATE
  DRYAD_FOREST
}

enum PreparationChoice {
  SEARCH_ARMORY
  INSPECT_TRACKS
  REST_BRAZIER
}

enum BattleStatus {
  ACTIVE
  WON
  LOST
  RETREATED
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
  DIVINE
}

enum ItemBinding {
  UNBOUND
  BOUND_ON_EQUIP
  BOUND
}

enum ItemLocation {
  CHEST
  BACKPACK
  EQUIPPED
  LOST
}

enum ItemLineageType {
  CREATED_FROM_BATTLE_REWARD
  STORED_IN_CHEST
  EQUIPPED
  LOST_IN_BATTLE
}

enum EquipmentSlot {
  HEAD
  SHOULDERS
  CHEST
  BRACERS
  HANDS
  WAIST
  LEGS
  FEET
  MAIN_HAND
  OFF_HAND
  AMULET
  BRACELET
  RING_LEFT
  RING_RIGHT
}

enum TalentType {
  VITALITY
  POWER
  RESILIENCE
  AWAKENED_VITALITY
  AWAKENED_POWER
  AWAKENED_RESILIENCE
}

enum ResourceType {
  IRON
  COPPER
  BRONZE
  COAL
  TIMBER
  LEATHER
  WEAPON_FRAGMENT
  HEALTH_POTION
  MANA_POTION
  HERBS
  OBSIDIAN_SHARD
  VEIL_STEEL
  STABILIZED_CATALYST
  VEIL_ECHO
  CURSED_HEART
  FALLEN_ELF_EYE
  DARK_PRIEST_ASH
  BOSS_INVOCATION_SEAL
  DRYAD_HEARTWOOD
}

enum ClanRole {
  LEADER
  ELDER
  MEMBER
}

enum ClanDevelopmentBranch {
  MILITARY
  HUNTING
  CRAFTING
  ECONOMIC
  MYSTIC
}

enum ClanBossStatus {
  ACTIVE
  WON
  EXPIRED
}

enum CraftingStation {
  WORKSHOP
  ALCHEMY_TABLE
  FORGE
  RITUAL_CIRCLE
}

enum CraftJobStatus {
  ACTIVE
  CLAIMED
}

enum WorldFaction {
  DAWN_COVENANT
  ASHEN_HOST
}

model User {
  id                String          @id @default(uuid()) @db.Uuid
  email             String          @unique @db.VarChar(320)
  passwordHash      String          @map("password_hash") @db.VarChar(255)
  role              UserRole        @default(PLAYER)
  status            UserStatus      @default(ACTIVE)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  sessions          Session[]
  character         Character?
  adminAuditEntries AdminAuditLog[] @relation("AdminAuditActor")

  @@map("users")
}

model Character {
  id                      String                     @id @default(uuid()) @db.Uuid
  userId                  String                     @unique @map("user_id") @db.Uuid
  name                    String                     @db.VarChar(24)
  nameKey                 String                     @unique @map("name_key") @db.VarChar(64)
  archetype               CharacterArchetype
  origin                  CharacterOrigin            @default(ROAD_SURVIVOR)
  avatarMode              AvatarMode                 @default(STATIC) @map("avatar_mode")
  staticAvatarId          String?                    @map("static_avatar_id") @db.VarChar(64)
  level                   Int                        @default(1)
  experience              Int                        @default(0)
  gold                    Int                        @default(0)
  version                 Int                        @default(1)
  faction                 WorldFaction?
  factionChanges          Int                        @default(0) @map("faction_changes")
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")
  user                    User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  worldState              CharacterWorldState?
  worldCommands           WorldCommand[]
  battles                 Battle[]
  rewardClaims            RewardClaim[]
  items                   ItemInstance[]
  equipment               EquipmentAssignment[]
  inventoryCommands       InventoryCommand[]
  expeditionGuideCommands ExpeditionGuideCommand[]
  talents                 CharacterTalent[]
  talentCommands          TalentCommand[]
  resources               CharacterResource[]
  resourceLedger          ResourceLedgerEntry[]
  clanMembership          ClanMembership?
  clanCommands            ClanCommand[]
  clanContributions       ClanContribution[]
  clanBossParticipations  ClanBossParticipant[]
  clanBossRewardClaims    ClanBossRewardClaim[]
  craftJobs               CraftJob[]
  craftCommands           CraftCommand[]
  recipeKnowledge         CharacterRecipeKnowledge[]
  factionCommands         FactionCommand[]
  bossInvocationCommands  BossInvocationCommand[]

  @@map("characters")
}

model Clan {
  id             String              @id @default(uuid()) @db.Uuid
  name           String              @db.VarChar(32)
  nameKey        String              @unique @map("name_key") @db.VarChar(64)
  inviteCode     String              @unique @map("invite_code") @db.Char(8)
  level          Int                 @default(1)
  experience     Int                 @default(0)
  version        Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  members        ClanMembership[]
  commands       ClanCommand[]
  resources      ClanResource[]
  contributions  ClanContribution[]
  developments   ClanDevelopment[]
  bossEncounters ClanBossEncounter[]

  @@map("clans")
}

model ClanBossEncounter {
  id            String                @id @default(uuid()) @db.Uuid
  clanId        String                @map("clan_id") @db.Uuid
  activeClanId  String?               @unique @map("active_clan_id") @db.Uuid
  tier          Int                   @default(1)
  status        ClanBossStatus        @default(ACTIVE)
  maxHealth     Int                   @map("max_health")
  currentHealth Int                   @map("current_health")
  version       Int                   @default(1)
  createdAt     DateTime              @default(now()) @map("created_at")
  completedAt   DateTime?             @map("completed_at")
  clan          Clan                  @relation(fields: [clanId], references: [id], onDelete: Cascade)
  participants  ClanBossParticipant[]
  rewardClaims  ClanBossRewardClaim[]

  @@index([clanId, createdAt])
  @@map("clan_boss_encounters")
}

model ClanBossParticipant {
  id            String               @id @default(uuid()) @db.Uuid
  encounterId   String               @map("encounter_id") @db.Uuid
  characterId   String               @map("character_id") @db.Uuid
  damage        Int                  @default(0)
  actions       Int                  @default(0)
  maxHealth     Int                  @default(0) @map("max_health")
  currentHealth Int                  @default(0) @map("current_health")
  defeatedAt    DateTime?            @map("defeated_at")
  joinedAt      DateTime             @default(now()) @map("joined_at")
  encounter     ClanBossEncounter    @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  character     Character            @relation(fields: [characterId], references: [id], onDelete: Cascade)
  rewardClaim   ClanBossRewardClaim?

  @@unique([encounterId, characterId])
  @@index([encounterId, damage])
  @@map("clan_boss_participants")
}

model ClanBossRewardClaim {
  id             String              @id @default(uuid()) @db.Uuid
  encounterId    String              @map("encounter_id") @db.Uuid
  characterId    String              @map("character_id") @db.Uuid
  participantId  String              @unique @map("participant_id") @db.Uuid
  idempotencyKey String              @map("idempotency_key") @db.VarChar(64)
  resourceType   ResourceType        @default(VEIL_ECHO) @map("resource_type")
  resourceAmount Int                 @map("resource_amount")
  createdAt      DateTime            @default(now()) @map("created_at")
  encounter      ClanBossEncounter   @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  character      Character           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  participant    ClanBossParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@unique([encounterId, characterId])
  @@unique([characterId, idempotencyKey])
  @@map("clan_boss_reward_claims")
}

model ClanDevelopment {
  id        String                @id @default(uuid()) @db.Uuid
  clanId    String                @map("clan_id") @db.Uuid
  branch    ClanDevelopmentBranch
  rank      Int                   @default(0)
  updatedAt DateTime              @updatedAt @map("updated_at")
  clan      Clan                  @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([clanId, branch])
  @@map("clan_developments")
}

model ClanMembership {
  id           String    @id @default(uuid()) @db.Uuid
  clanId       String    @map("clan_id") @db.Uuid
  characterId  String    @unique @map("character_id") @db.Uuid
  role         ClanRole  @default(MEMBER)
  joinedAt     DateTime  @default(now()) @map("joined_at")
  roleSince    DateTime  @default(now()) @map("role_since")
  contribution Int       @default(0)
  clan         Clan      @relation(fields: [clanId], references: [id], onDelete: Cascade)
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([clanId, joinedAt])
  @@map("clan_memberships")
}

model ClanResource {
  id        String       @id @default(uuid()) @db.Uuid
  clanId    String       @map("clan_id") @db.Uuid
  type      ResourceType
  balance   Int          @default(0)
  updatedAt DateTime     @updatedAt @map("updated_at")
  clan      Clan         @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([clanId, type])
  @@map("clan_resources")
}

model ClanContribution {
  id             String       @id @default(uuid()) @db.Uuid
  clanId         String       @map("clan_id") @db.Uuid
  characterId    String       @map("character_id") @db.Uuid
  resourceType   ResourceType @map("resource_type")
  amount         Int
  experienceGain Int          @map("experience_gain")
  referenceId    String       @map("reference_id") @db.VarChar(64)
  createdAt      DateTime     @default(now()) @map("created_at")
  clan           Clan         @relation(fields: [clanId], references: [id], onDelete: Cascade)
  character      Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, referenceId])
  @@index([clanId, createdAt])
  @@map("clan_contributions")
}

model ClanCommand {
  id             String    @id @default(uuid()) @db.Uuid
  clanId         String    @map("clan_id") @db.Uuid
  characterId    String    @map("character_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key") @db.VarChar(64)
  commandType    String    @map("command_type") @db.VarChar(32)
  payloadHash    String    @map("payload_hash") @db.Char(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  clan           Clan      @relation(fields: [clanId], references: [id], onDelete: Cascade)
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, idempotencyKey])
  @@index([clanId, createdAt])
  @@map("clan_commands")
}

model CharacterTalent {
  id          String     @id @default(uuid()) @db.Uuid
  characterId String     @map("character_id") @db.Uuid
  type        TalentType
  rank        Int        @default(0)
  updatedAt   DateTime   @updatedAt @map("updated_at")
  character   Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, type])
  @@map("character_talents")
}

model TalentCommand {
  id             String    @id @default(uuid()) @db.Uuid
  characterId    String    @map("character_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key") @db.VarChar(64)
  payloadHash    String    @map("payload_hash") @db.Char(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, idempotencyKey])
  @@map("talent_commands")
}

model CraftJob {
  id            String           @id @default(uuid()) @db.Uuid
  characterId   String           @map("character_id") @db.Uuid
  recipeId      String           @map("recipe_id") @db.VarChar(64)
  station       CraftingStation
  activeStation CraftingStation? @map("active_station")
  status        CraftJobStatus   @default(ACTIVE)
  quantity      Int              @default(1)
  outputType    ResourceType     @map("output_type")
  outputAmount  Int              @map("output_amount")
  startedAt     DateTime         @default(now()) @map("started_at")
  completesAt   DateTime         @map("completes_at")
  claimedAt     DateTime?        @map("claimed_at")
  character     Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, activeStation])
  @@index([characterId, status, completesAt])
  @@map("craft_jobs")
}

model CraftCommand {
  id             String    @id @default(uuid()) @db.Uuid
  characterId    String    @map("character_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key") @db.VarChar(64)
  commandType    String    @map("command_type") @db.VarChar(32)
  payloadHash    String    @map("payload_hash") @db.Char(64)
  craftJobId     String?   @map("craft_job_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, idempotencyKey])
  @@map("craft_commands")
}

model CharacterRecipeKnowledge {
  id           String    @id @default(uuid()) @db.Uuid
  characterId  String    @map("character_id") @db.Uuid
  recipeId     String    @map("recipe_id") @db.VarChar(64)
  source       String    @db.VarChar(64)
  discoveredAt DateTime  @default(now()) @map("discovered_at")
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, recipeId])
  @@index([characterId, discoveredAt])
  @@map("character_recipe_knowledge")
}

model FactionCommand {
  id             String       @id @default(uuid()) @db.Uuid
  characterId    String       @map("character_id") @db.Uuid
  idempotencyKey String       @map("idempotency_key") @db.VarChar(64)
  payloadHash    String       @map("payload_hash") @db.Char(64)
  faction        WorldFaction
  createdAt      DateTime     @default(now()) @map("created_at")
  character      Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, idempotencyKey])
  @@map("faction_commands")
}

model CharacterResource {
  id          String       @id @default(uuid()) @db.Uuid
  characterId String       @map("character_id") @db.Uuid
  type        ResourceType
  balance     Int          @default(0)
  updatedAt   DateTime     @updatedAt @map("updated_at")
  character   Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, type])
  @@map("character_resources")
}

model ResourceLedgerEntry {
  id          String       @id @default(uuid()) @db.Uuid
  characterId String       @map("character_id") @db.Uuid
  type        ResourceType
  amount      Int
  reason      String       @db.VarChar(32)
  referenceId String       @map("reference_id") @db.VarChar(64)
  createdAt   DateTime     @default(now()) @map("created_at")
  character   Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, type, reason, referenceId])
  @@index([characterId, createdAt])
  @@map("resource_ledger_entries")
}

model Battle {
  id                   String                 @id @default(uuid()) @db.Uuid
  characterId          String                 @map("character_id") @db.Uuid
  activeCharacterId    String?                @unique @map("active_character_id") @db.Uuid
  encounterId          String                 @map("encounter_id") @db.VarChar(64)
  status               BattleStatus           @default(ACTIVE)
  version              Int                    @default(1)
  seed                 Int
  state                Json
  pendingState         Json?                  @map("pending_state")
  enemyReadyAt         DateTime?              @map("enemy_ready_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  completedAt          DateTime?              @map("completed_at")
  resultAcknowledgedAt DateTime?              @map("result_acknowledged_at")
  character            Character              @relation(fields: [characterId], references: [id], onDelete: Cascade)
  commands             BattleCommand[]
  rewardClaim          RewardClaim?
  rewardItem           ItemInstance?
  invocationCommand    BossInvocationCommand?

  @@index([characterId, status])
  @@map("battles")
}

model BattleCommand {
  id               String   @id @default(uuid()) @db.Uuid
  battleId         String   @map("battle_id") @db.Uuid
  idempotencyKey   String   @map("idempotency_key") @db.VarChar(64)
  expectedVersion  Int      @map("expected_version")
  actionId         String   @map("action_id") @db.VarChar(64)
  targetEnemyId    String?  @map("target_enemy_id") @db.VarChar(64)
  resultingVersion Int      @map("resulting_version")
  createdAt        DateTime @default(now()) @map("created_at")
  battle           Battle   @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@unique([battleId, idempotencyKey])
  @@map("battle_commands")
}

model BossInvocationCommand {
  id             String    @id @default(uuid()) @db.Uuid
  characterId    String    @map("character_id") @db.Uuid
  battleId       String    @unique @map("battle_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key") @db.VarChar(64)
  payloadHash    String    @map("payload_hash") @db.Char(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  battle         Battle    @relation(fields: [battleId], references: [id], onDelete: Restrict)

  @@unique([characterId, idempotencyKey])
  @@map("boss_invocation_commands")
}

model CharacterWorldState {
  characterId         String             @id @map("character_id") @db.Uuid
  currentLocation     WorldLocation      @default(BROKEN_WATCHPOST) @map("current_location")
  preparationChoice   PreparationChoice? @map("preparation_choice")
  version             Int                @default(1)
  cinderhavenUnlocked Boolean            @default(false) @map("cinderhaven_unlocked")
  highestClearedTier  Int                @default(0) @map("highest_cleared_tier")
  guideCheckpointTier Int                @default(1) @map("guide_checkpoint_tier")
  dryadHighestClearedTier Int            @default(0) @map("dryad_highest_cleared_tier")
  dryadGuideCheckpointTier Int           @default(1) @map("dryad_guide_checkpoint_tier")
  rareEncounterWeek   String?            @map("rare_encounter_week") @db.VarChar(10)
  rareEncounterChecks Int                @default(0) @map("rare_encounter_checks")
  rareEncounterCount  Int                @default(0) @map("rare_encounter_count")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  character           Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_world_states")
}

model ExpeditionGuideCommand {
  id             String    @id @default(uuid()) @db.Uuid
  characterId    String    @map("character_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key") @db.VarChar(64)
  payloadHash    String    @map("payload_hash") @db.Char(64)
  checkpointTier Int       @map("checkpoint_tier")
  goldCost       Int       @map("gold_cost")
  createdAt      DateTime  @default(now()) @map("created_at")
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, idempotencyKey])
  @@map("expedition_guide_commands")
}

model RewardClaim {
  id             String        @id @default(uuid()) @db.Uuid
  battleId       String        @unique @map("battle_id") @db.Uuid
  characterId    String        @map("character_id") @db.Uuid
  idempotencyKey String        @map("idempotency_key") @db.VarChar(64)
  experience     Int
  gold           Int
  resourceType   ResourceType  @default(IRON) @map("resource_type")
  resourceAmount Int           @default(0) @map("resource_amount")
  createdAt      DateTime      @default(now()) @map("created_at")
  battle         Battle        @relation(fields: [battleId], references: [id], onDelete: Restrict)
  character      Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item           ItemInstance?
  resources      RewardClaimResource[]

  @@unique([characterId, idempotencyKey])
  @@map("reward_claims")
}

model RewardClaimResource {
  id            String       @id @default(uuid()) @db.Uuid
  rewardClaimId String       @map("reward_claim_id") @db.Uuid
  type          ResourceType
  amount        Int
  rewardClaim   RewardClaim  @relation(fields: [rewardClaimId], references: [id], onDelete: Cascade)

  @@unique([rewardClaimId, type])
  @@map("reward_claim_resources")
}

model ItemInstance {
  id                  String               @id @default(uuid()) @db.Uuid
  definitionId        String               @map("definition_id") @db.VarChar(64)
  ownerId             String               @map("owner_id") @db.Uuid
  sourceBattleId      String               @unique @map("source_battle_id") @db.Uuid
  rewardClaimId       String               @unique @map("reward_claim_id") @db.Uuid
  itemLevel           Int                  @default(1) @map("item_level")
  rarity              ItemRarity
  rollQuality         Int                  @default(0) @map("roll_quality")
  damage              Int
  armor               Int                  @default(0)
  health              Int                  @default(0)
  binding             ItemBinding          @default(BOUND_ON_EQUIP)
  location            ItemLocation         @default(CHEST)
  setId               String               @map("set_id") @db.VarChar(64)
  visualAssetId       String               @map("visual_asset_id") @db.VarChar(64)
  createdAt           DateTime             @default(now()) @map("created_at")
  owner               Character            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sourceBattle        Battle               @relation(fields: [sourceBattleId], references: [id], onDelete: Restrict)
  rewardClaim         RewardClaim          @relation(fields: [rewardClaimId], references: [id], onDelete: Restrict)
  lineage             ItemLineageEvent[]
  equipmentAssignment EquipmentAssignment?

  @@index([ownerId, location])
  @@map("item_instances")
}

model EquipmentAssignment {
  id          String        @id @default(uuid()) @db.Uuid
  characterId String        @map("character_id") @db.Uuid
  itemId      String        @unique @map("item_id") @db.Uuid
  slot        EquipmentSlot
  equippedAt  DateTime      @default(now()) @map("equipped_at")
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item        ItemInstance  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([characterId, slot])
  @@map("equipment_assignments")
}

model InventoryCommand {
  id             String    @id @default(uuid()) @db.Uuid
  characterId    String    @map("character_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key") @db.VarChar(64)
  payloadHash    String    @map("payload_hash") @db.Char(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, idempotencyKey])
  @@map("inventory_commands")
}

model ItemLineageEvent {
  id        String          @id @default(uuid()) @db.Uuid
  itemId    String          @map("item_id") @db.Uuid
  type      ItemLineageType
  payload   Json
  createdAt DateTime        @default(now()) @map("created_at")
  item      ItemInstance    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@map("item_lineage_events")
}

model WorldCommand {
  id             String    @id @default(uuid()) @db.Uuid
  characterId    String    @map("character_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key") @db.VarChar(64)
  commandType    String    @map("command_type") @db.VarChar(32)
  payloadHash    String    @map("payload_hash") @db.Char(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, idempotencyKey])
  @@index([characterId, createdAt])
  @@map("world_commands")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AdminAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String   @map("actor_user_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(64)
  payloadHash    String   @map("payload_hash") @db.Char(64)
  action         String   @db.VarChar(64)
  targetType     String   @map("target_type") @db.VarChar(32)
  targetId       String   @map("target_id") @db.VarChar(64)
  reason         String   @db.VarChar(500)
  before         Json
  after          Json
  createdAt      DateTime @default(now()) @map("created_at")
  actor          User     @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([actorUserId, idempotencyKey])
  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("admin_audit_logs")
}
